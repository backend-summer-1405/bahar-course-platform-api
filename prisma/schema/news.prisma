model News {
  id      String @id @default(uuid())
  title   String
  slug    String @unique
  content String

  authorId String
  author   User   @relation("NewsAuthor", fields: [authorId], references: [id])

  comments  NewsComment[]
  ratings   NewsRating[]
  reactions NewsReaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}